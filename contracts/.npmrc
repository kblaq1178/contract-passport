# Scaffold Stacks adoption note:
# stacksdapp runs plain `npm install` / `npm ci` and cannot pass extra flags.
# npm 10's peer resolver crashes on this project's vitest / vitest-environment-clarinet
# graph (see README: "Cannot read properties of null (reading 'edgesOut')"), so the
# project's documented install mode is recorded here for npm invocations in contracts/.
legacy-peer-deps=true
